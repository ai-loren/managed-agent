# Managed-Agent demo configuration.
#
# Copy this file to `.env.demo` (which is gitignored) and fill in your values,
# then run `pnpm demo` or `pnpm start`. Nothing here is required — with no key
# the demo runs an offline echo model.
#
# scripts/start.sh reads this file as data: `KEY=value` lines for MA_* settings
# only, nothing is executed, and flags and the environment win over it. With
# `--prod` only the model settings (MA_OPENROUTER_*, MA_MODEL_TOOLS) are used.

# An OpenRouter API key. Get one at https://openrouter.ai/keys.
# Leave blank to use the offline echo model.
MA_OPENROUTER_API_KEY=

# Which model to use. Free models end in `:free`; browse them at
# https://openrouter.ai/models?max_price=0
MA_OPENROUTER_MODEL=nex-agi/nex-n2.5-mini:free

# The admin token the demo prints and you paste into the console. This value is
# public (it is in the repository): the demo accepts it, the production server
# refuses to create an admin from it.
MA_BOOTSTRAP_TOKEN=demo-admin-token

# Where the console + API listen.
MA_PORT=8080
MA_HOST=127.0.0.1

# In-memory store: a demo run leaves nothing behind. Point at a file to persist.
MA_DATABASE=:memory:
