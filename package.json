{
  "name": "managed-agent",
  "version": "0.1.0",
  "private": true,
  "description": "A general-purpose cloud platform for hosting, governing and observing autonomous agents.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "build": "tsc --build",
    "build:clean": "tsc --build --clean",
    "watch": "tsc --build --watch",
    "typecheck": "tsc --build --force",
    "test": "node --test --test-timeout=30000 \"packages/*/test/**/*.test.ts\" \"apps/*/test/**/*.test.ts\"",
    "test:watch": "node --test --test-timeout=30000 --watch \"packages/*/test/**/*.test.ts\"",
    "lint": "node scripts/lint.mjs",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "load": "node apps/server/test/load/run.ts",
    "dev": "node apps/server/src/main.ts",
    "start": "bash scripts/start.sh",
    "demo": "bash scripts/dev.sh"
  },
  "devDependencies": {
    "@types/node": "^26.5.0",
    "typescript": "^7.0.2"
  }
}
